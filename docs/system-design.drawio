<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net"><diagram name="All phases combined" id="all"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="all-title" value="Voice receptionist: system design, all phases combined" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="all-subtitle" value="Bright Smile Dental's receptionist as it stands after phase 8. The tag on each box is the phase that added it (P1 to P8)." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="all-lg-c" value="Built, in the bot" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="34" as="geometry" /></mxCell><mxCell id="all-lg-e" value="Person, device or outside service" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="230" height="34" as="geometry" /></mxCell><mxCell id="all-lg-t" value="Tests and observability" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="180" height="34" as="geometry" /></mxCell><mxCell id="all-lg-p" value="Built, not live or untested" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="200" height="34" as="geometry" /></mxCell><mxCell id="all-lg-d" value="Data" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="840" y="96" width="80" height="42" as="geometry" /></mxCell><mxCell id="all-browser" value='Browser caller&lt;br&gt;&lt;font style="font-size: 12px;"&gt;WebRTC client · P4&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="64" as="geometry" /></mxCell><mxCell id="all-lk" value='LiveKit caller&lt;br&gt;&lt;font style="font-size: 12px;"&gt;a room per call · P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="230" y="170" width="170" height="64" as="geometry" /></mxCell><mxCell id="all-phone" value='Phone caller&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Twilio, Plivo, Exotel · P4b, P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="210" height="64" as="geometry" /></mxCell><mxCell id="all-sims" value='Simulated callers&lt;br&gt;&lt;font style="font-size: 12px;"&gt;eval harness, phone and LiveKit simulators · P6&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="250" height="64" as="geometry" /></mxCell><mxCell id="all-evals" value='Eval reports&lt;br&gt;&lt;font style="font-size: 12px;"&gt;voice suite, grounding, transfer and trace checks · P6 to P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="960" y="170" width="300" height="64" as="geometry" /></mxCell><mxCell id="all-transport" value="Pipecat transports: WebRTC · LiveKit rooms · phone WebSocket (one bot, any provider) · eval" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1220" height="50" as="geometry" /></mxCell><mxCell id="all-pipe" value="Pipeline (bot.py), one per call" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="1240" height="160" as="geometry" /></mxCell><mxCell id="all-stt" value='Speech-to-text&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Whisper on GPU, hotwords · P2, P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="15" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-gate" value="Hold gate&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;on hold: drops the caller's words · P8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="191" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-keypad" value='Keypad entry&lt;br&gt;&lt;font style="font-size: 12px;"&gt;DTMF digits · P7&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="367" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-turn" value='Turn detection&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Silero VAD + Smart Turn · P3, P4&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="543" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-facts" value='Clinic facts&lt;br&gt;&lt;font style="font-size: 12px;"&gt;rag.py, before the LLM · P7&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="719" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-llm" value='LLM&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Claude Haiku 5.5 · P2&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="895" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-tts" value='Voice&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Kokoro, or ElevenLabs with Kokoro failover · P2, P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="all-pipe"><mxGeometry x="1071" y="46" width="160" height="96" as="geometry" /></mxCell><mxCell id="all-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-stt" target="all-gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-gate" target="all-keypad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-keypad" target="all-turn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-turn" target="all-facts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-facts" target="all-llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-llm" target="all-tts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-tel" value='Traces (telemetry.py)&lt;br&gt;&lt;font style="font-size: 12px;"&gt;call, turn, service, tool and transfer spans · P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="230" height="80" as="geometry" /></mxCell><mxCell id="all-jaeger" value='Jaeger or SigNoz&lt;br&gt;&lt;font style="font-size: 12px;"&gt;OTLP/HTTP · P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="320" y="590" width="170" height="80" as="geometry" /></mxCell><mxCell id="all-observer" value='Latency observer&lt;br&gt;&lt;font style="font-size: 12px;"&gt;per-stage timings · P4&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="170" height="80" as="geometry" /></mxCell><mxCell id="all-knowledge" value='Clinic documents&lt;br&gt;&lt;font style="font-size: 12px;"&gt;6 files, 29 sections · P7&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="750" y="580" width="170" height="100" as="geometry" /></mxCell><mxCell id="all-tools" value='Tools (tools.py)&lt;br&gt;&lt;font style="font-size: 12px;"&gt;check, book, reschedule, take a message, transfer, end call · P5, P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="940" y="590" width="190" height="110" as="geometry" /></mxCell><mxCell id="all-db" value='Appointments and messages&lt;br&gt;&lt;font style="font-size: 12px;"&gt;SQLite · P5, P8&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1150" y="580" width="150" height="120" as="geometry" /></mxCell><mxCell id="all-calendar" value='External calendar&lt;br&gt;&lt;font style="font-size: 12px;"&gt;planned&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="760" width="150" height="64" as="geometry" /></mxCell><mxCell id="all-desk" value='Front desk (transfer.py)&lt;br&gt;&lt;font style="font-size: 12px;"&gt;hold music, private briefing, handover · P8&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="925" y="760" width="200" height="84" as="geometry" /></mxCell><mxCell id="all-staff" value="Front-desk staff&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;staff.html; joins the caller's room on Accept · P8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="925" y="900" width="200" height="84" as="geometry" /></mxCell><mxCell id="all-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.07;entryY=0;" edge="1" parent="1" source="all-browser" target="all-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.225;entryY=0;" edge="1" parent="1" source="all-lk" target="all-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="all-phone" target="all-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="all-sims" target="all-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-sims" target="all-evals"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e11" value="audio in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.07;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="all-transport" target="all-stt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e12" value="audio out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=0;entryX=0.935;entryY=1;" edge="1" parent="1" source="all-tts" target="all-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-knowledge" target="all-facts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e14" value="tool calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;" edge="1" parent="1" source="all-llm" target="all-tools"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-tools" target="all-db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e16" value="transfer_to_staff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-tools" target="all-desk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e17" value="briefing in the desk room" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-desk" target="all-staff"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e18" value="could move to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="all-db" target="all-calendar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e19" value="timings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="all-turn" target="all-observer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e20" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="all-tel" target="all-jaeger"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="all-e21" value="spans" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="all-stt" target="all-tel"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 1: naive loop" id="p1"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1-title" value="Phase 1: the naive loop (voice_loop.py)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p1-subtitle" value="Everything blocks: the mic is only open while listening, the whole reply is awaited, then spoken." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p1-mic" value='Mic&lt;br&gt;&lt;font style="font-size: 12px;"&gt;open only while listening&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1-vad" value='Loudness threshold&lt;br&gt;&lt;font style="font-size: 12px;"&gt;0.8 s of silence ends the turn&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1-stt" value='Whisper base.en&lt;br&gt;&lt;font style="font-size: 12px;"&gt;on the CPU&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1-llm" value='Claude Opus 5.5&lt;br&gt;&lt;font style="font-size: 12px;"&gt;waits for the whole reply&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1-tts" value='Windows voice&lt;br&gt;&lt;font style="font-size: 12px;"&gt;instant, robotic&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1-spk" value="Speaker" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p1-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p1-mic" target="p1-vad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p1-vad" target="p1-stt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p1-stt" target="p1-llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p1-llm" target="p1-tts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p1-tts" target="p1-spk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-n" value="Baseline over six live turns: 810 ms waiting for silence, 613 ms speech-to-text, 1,804 ms LLM. Reply starts 3.2 s after the caller stops." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="580" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 2: streaming and GPU" id="p2"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2-title" value="Phase 2: streaming and the GPU" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p2-subtitle" value="Stream the reply sentence by sentence, run speech-to-text and the voice on the GPU, use a faster model." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p2-mic" value="Mic" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-vad" value="Loudness threshold" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="212" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-stt" value='Whisper base.en&lt;br&gt;&lt;font style="font-size: 12px;"&gt;GPU: 641 to 110 ms&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="384" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-llm" value='Claude Haiku 5.5&lt;br&gt;&lt;font style="font-size: 12px;"&gt;streamed, split into sentences&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="556" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-tts" value='Kokoro neural voice&lt;br&gt;&lt;font style="font-size: 12px;"&gt;GPU: 1,267 to 251 ms&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="728" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-queue" value='Playback queue&lt;br&gt;&lt;font style="font-size: 12px;"&gt;background thread&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-spk" value="Speaker" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1072" y="130" width="150" height="76" as="geometry" /></mxCell><mxCell id="p2-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p2-mic" target="p2-vad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p2-vad" target="p2-stt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p2-stt" target="p2-llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p2-llm" target="p2-tts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p2-tts" target="p2-queue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p2-queue" target="p2-spk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-n" value="Haiku instead of Opus cut the first sentence from 1,186 to 754 ms; streaming alone saved less, since replies are one or two sentences. Reply starts 2.15 s after the caller stops (simulated)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="640" height="76" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 3: turn-taking" id="p3"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3-title" value="Phase 3: turn-taking" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p3-subtitle" value="The mic never closes; replies run on a worker thread that a caller can cut off." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p3-mic" value='Mic, always open&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Silero VAD&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p3-ep" value='Endpointer&lt;br&gt;&lt;font style="font-size: 12px;"&gt;start and end of speech&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="170" height="70" as="geometry" /></mxCell><mxCell id="p3-worker" value='Worker thread&lt;br&gt;&lt;font style="font-size: 12px;"&gt;speech-to-text, LLM, voice; cancellable&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="200" height="70" as="geometry" /></mxCell><mxCell id="p3-queue" value="Playback queue" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="160" height="70" as="geometry" /></mxCell><mxCell id="p3-spk" value="Speaker" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="130" height="70" as="geometry" /></mxCell><mxCell id="p3-cancel" value='Cancel the reply&lt;br&gt;&lt;font style="font-size: 12px;"&gt;stop the speaker&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="255" y="300" width="200" height="70" as="geometry" /></mxCell><mxCell id="p3-hist" value='Conversation history&lt;br&gt;&lt;font style="font-size: 12px;"&gt;keeps only what was played&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="280" width="190" height="90" as="geometry" /></mxCell><mxCell id="p3-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p3-mic" target="p3-ep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e1" value="end: 0.4 s of quiet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p3-ep" target="p3-worker"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p3-worker" target="p3-queue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p3-queue" target="p3-spk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e4" value="start: the caller talks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3-ep" target="p3-cancel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1" source="p3-cancel" target="p3-worker"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;exitX=1;exitY=0.7;entryX=0.3;entryY=1;" edge="1" parent="1" source="p3-cancel" target="p3-queue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-e7" value="played sentences" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.8;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-queue" target="p3-hist"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-n" value="Interruption: stop triggered 256 ms after the caller's voice began, speaker silent 177 ms later. Eager end of turn answers after 0.4 s of quiet and drops the reply if the caller was only pausing. Reply 1.5 to 1.9 s." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="700" height="76" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 4: Pipecat" id="p4"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4-title" value="Phase 4: rebuilt on Pipecat (bot.py)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p4-subtitle" value="The same receptionist on a voice framework, talking to a browser over WebRTC." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p4-browser" value='Browser&lt;br&gt;&lt;font style="font-size: 12px;"&gt;mic and speaker; cancels echo&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="70" as="geometry" /></mxCell><mxCell id="p4-transport" value='Pipecat transport&lt;br&gt;&lt;font style="font-size: 12px;"&gt;WebRTC&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="260" height="70" as="geometry" /></mxCell><mxCell id="p4-pipe" value="Pipeline (bot.py)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="1160" height="150" as="geometry" /></mxCell><mxCell id="p4-stt" value='WhisperSTTService&lt;br&gt;&lt;font style="font-size: 12px;"&gt;speech-to-text&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p4-pipe"><mxGeometry x="20" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p4-user" value='User aggregator&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Silero VAD (loudness 0.72) + Smart Turn&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p4-pipe"><mxGeometry x="248" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p4-llm" value='AnthropicLLMService&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Claude Haiku 5.5&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p4-pipe"><mxGeometry x="476" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p4-tts" value='KokoroTTSService&lt;br&gt;&lt;font style="font-size: 12px;"&gt;voice&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p4-pipe"><mxGeometry x="704" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p4-asst" value='Assistant aggregator&lt;br&gt;&lt;font style="font-size: 12px;"&gt;records what was actually said&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p4-pipe"><mxGeometry x="932" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p4-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p4-stt" target="p4-user"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p4-user" target="p4-llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p4-llm" target="p4-tts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-obs" value='Latency observer&lt;br&gt;&lt;font style="font-size: 12px;"&gt;per-stage timings&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="270" y="480" width="200" height="64" as="geometry" /></mxCell><mxCell id="p4-e3" value="WebRTC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;" edge="1" parent="1" source="p4-browser" target="p4-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-e4" value="audio in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4-transport" target="p4-stt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-e5" value="audio out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="p4-tts" target="p4-transport"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-e6" value="what was played" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4-transport" target="p4-asst"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-e7" value="timings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="p4-user" target="p4-obs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4-n" value="First live call: a noisy room became one long caller turn, 28 interruptions in 11 minutes. The VAD's speech score cannot tell near from far, so a loudness floor of 0.72 (default 0.60) fixed it. Reply 1.83 s." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="620" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 4b: phone line" id="p4b"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4b-title" value="Phase 4b: the phone line" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p4b-subtitle" value="Only the transport changes: a phone provider streams the call's audio to the same pipeline." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p4b-phone" value="Caller's phone" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="70" as="geometry" /></mxCell><mxCell id="p4b-twilio" value='Twilio number&lt;br&gt;&lt;font style="font-size: 12px;"&gt;built, not yet live&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="190" height="70" as="geometry" /></mxCell><mxCell id="p4b-runner" value='Pipecat runner&lt;br&gt;&lt;font style="font-size: 12px;"&gt;bot.py -t twilio answers with TwiML&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="260" height="70" as="geometry" /></mxCell><mxCell id="p4b-pipe" value='Same pipeline&lt;br&gt;&lt;font style="font-size: 12px;"&gt;speech-to-text, LLM, voice; greets on connect&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="260" height="80" as="geometry" /></mxCell><mxCell id="p4b-rest" value='Twilio REST API&lt;br&gt;&lt;font style="font-size: 12px;"&gt;caller ID lookup, hang-up&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="275" width="200" height="70" as="geometry" /></mxCell><mxCell id="p4b-sim" value='Phone call simulator&lt;br&gt;&lt;font style="font-size: 12px;"&gt;evals/phone_call.py, 8 kHz mu-law&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="665" y="450" width="210" height="70" as="geometry" /></mxCell><mxCell id="p4b-e0" value="call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p4b-phone" target="p4b-twilio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4b-e1" value="webhook: what do I do?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4b-twilio" target="p4b-runner"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4b-e2" value="8 kHz audio over a WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4b-twilio" target="p4b-pipe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4b-e3" value="caller ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="p4b-pipe" target="p4b-rest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4b-e4" value="speaks Twilio's protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="p4b-sim" target="p4b-pipe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4b-n" value="The caller's number arrives with the call, so the bot reads it back instead of asking for it. Simulated calls answered 1.9 to 3.5 s after the caller's last word." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="700" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 5: booking tools" id="p5"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p5-title" value="Phase 5: booking tools (tools.py)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p5-subtitle" value="Claude can check free times, book, reschedule and hang up. The clinic's rules live in code, not the prompt." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p5-llm" value="Claude Haiku 5.5" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="180" height="70" as="geometry" /></mxCell><mxCell id="p5-tools" value='tools.py&lt;br&gt;&lt;font style="font-size: 12px;"&gt;check_availability · book_appointment · reschedule_appointment&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="250" height="90" as="geometry" /></mxCell><mxCell id="p5-rules" value='Clinic rules in code&lt;br&gt;&lt;font style="font-size: 12px;"&gt;weekdays 9 to 5, half-hour slots, 10-digit numbers&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="230" height="90" as="geometry" /></mxCell><mxCell id="p5-db" value='Appointments&lt;br&gt;&lt;font style="font-size: 12px;"&gt;SQLite: the slot start is the primary key&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="190" height="110" as="geometry" /></mxCell><mxCell id="p5-hang" value='end_call(farewell)&lt;br&gt;&lt;font style="font-size: 12px;"&gt;says goodbye, then ends the call&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="250" height="70" as="geometry" /></mxCell><mxCell id="p5-e0" value="tool calls and results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;" edge="1" parent="1" source="p5-llm" target="p5-tools"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p5-tools" target="p5-rules"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p5-rules" target="p5-db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-llm" target="p5-hang"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5-n" value="The database itself refuses a double booking. A refused request comes back as a sentence the bot can say. The goodbye is an argument because, left to say it first, the model sometimes hung up in silence." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="320" width="500" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 6: evals" id="p6"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p6-title" value="Phase 6: automated voice evals" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p6-subtitle" value="Simulated callers phone a fresh bot and deterministic checks score what it did. No LLM judge." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p6-suite" value='Eval suite&lt;br&gt;&lt;font style="font-size: 12px;"&gt;evals/manifest.yaml, 3 runs per scenario&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="240" height="70" as="geometry" /></mxCell><mxCell id="p6-scen" value='Scenarios&lt;br&gt;&lt;font style="font-size: 12px;"&gt;evals/scenarios/*.yaml&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="190" height="90" as="geometry" /></mxCell><mxCell id="p6-caller" value='Scripted caller&lt;br&gt;&lt;font style="font-size: 12px;"&gt;synthesised speech (Kokoro)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="210" height="70" as="geometry" /></mxCell><mxCell id="p6-bot" value='Fresh bot.py per call&lt;br&gt;&lt;font style="font-size: 12px;"&gt;eval transport; APPOINTMENTS_DB=fresh&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="610" y="260" width="240" height="70" as="geometry" /></mxCell><mxCell id="p6-checks" value='Deterministic checks&lt;br&gt;&lt;font style="font-size: 12px;"&gt;tool calls and arguments, LLM text, timings&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="930" y="255" width="240" height="80" as="geometry" /></mxCell><mxCell id="p6-report" value='evals/report.py&lt;br&gt;&lt;font style="font-size: 12px;"&gt;docs/eval-report.md: pass rate, p50/p95, cost&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="1250" y="255" width="240" height="80" as="geometry" /></mxCell><mxCell id="p6-e0" value="starts one per call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p6-suite" target="p6-bot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e1" value="lines" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p6-scen" target="p6-caller"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e2" value="audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p6-caller" target="p6-bot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e3" value="what it did" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p6-bot" target="p6-checks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e4" value="expectations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p6-scen" target="p6-checks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p6-checks" target="p6-report"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-n" value='First run: 17 of 21 passed. It found a real bug: speech-to-text dropped a digit from "741 333 3333" every time, which phase 7 fixed with keypad entry.' style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="640" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 7: knowledge base" id="p7"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p7-title" value="Phase 7: clinic knowledge base (rag.py)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p7-subtitle" value="Answers about prices, insurance, hours, parking and visits come from the clinic's own documents." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p7-docs" value='knowledge/*.md&lt;br&gt;&lt;font style="font-size: 12px;"&gt;6 documents&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="190" height="90" as="geometry" /></mxCell><mxCell id="p7-index" value='Index&lt;br&gt;&lt;font style="font-size: 12px;"&gt;29 chunks, BGE-small on the CPU, built at start-up&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="220" height="70" as="geometry" /></mxCell><mxCell id="p7-ground" value='Grounding test&lt;br&gt;&lt;font style="font-size: 12px;"&gt;evals/grounding.py: 25 cases x 10 runs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="970" y="120" width="230" height="70" as="geometry" /></mxCell><mxCell id="p7-turn" value="Caller's turn&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;every fragment of it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="180" height="70" as="geometry" /></mxCell><mxCell id="p7-judge" value="Is any fragment a clinic question?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="230" height="110" as="geometry" /></mxCell><mxCell id="p7-search" value='Search the whole turn&lt;br&gt;&lt;font style="font-size: 12px;"&gt;top 5, within 0.10 of the best&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="220" height="70" as="geometry" /></mxCell><mxCell id="p7-block" value='One clinic_facts block&lt;br&gt;&lt;font style="font-size: 12px;"&gt;after the turn; never repeated&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="970" y="290" width="230" height="70" as="geometry" /></mxCell><mxCell id="p7-none" value='No facts&lt;br&gt;&lt;font style="font-size: 12px;"&gt;booking and small talk&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="210" height="64" as="geometry" /></mxCell><mxCell id="p7-keypad" value='Keypad entry&lt;br&gt;&lt;font style="font-size: 12px;"&gt;exact DTMF digits, asked for when a number is not 10 digits&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="680" y="450" width="220" height="80" as="geometry" /></mxCell><mxCell id="p7-llm" value='Claude Haiku 5.5&lt;br&gt;&lt;font style="font-size: 12px;"&gt;unmentioned means unknown, not no&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="970" y="455" width="230" height="70" as="geometry" /></mxCell><mxCell id="p7-e0" value="one chunk per section" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-docs" target="p7-index"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-index" target="p7-search"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e2" value="same prompt, retrieval and tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;" edge="1" parent="1" source="p7-ground" target="p7-block"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-turn" target="p7-judge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-judge" target="p7-none"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-judge" target="p7-search"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-search" target="p7-block"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-block" target="p7-llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p7-keypad" target="p7-llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-n" value="Retrieval runs inside the pipeline, 17 to 37 ms a turn, with no extra LLM round trip. Right section among the facts sent: 49 of 49 questions." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="820" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Phase 8: transfer and more" id="p8"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p8-title" value="Phase 8: handing a call to a person, and the job description's stack" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell><mxCell id="p8-subtitle" value="LiveKit rooms, a warm transfer to the front desk, OpenTelemetry traces, a cloud voice with a local fallback, and Plivo and Exotel phone lines." style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry" /></mxCell><mxCell id="p8-caller" value='Caller&lt;br&gt;&lt;font style="font-size: 12px;"&gt;LiveKit client or scripted caller&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="190" height="70" as="geometry" /></mxCell><mxCell id="p8-lk" value="LiveKit server (local)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="660" height="130" as="geometry" /></mxCell><mxCell id="p8-croom" value="Caller's room&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;one per call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="p8-lk"><mxGeometry x="20" y="46" width="250" height="64" as="geometry" /></mxCell><mxCell id="p8-droom" value='Front-desk room&lt;br&gt;&lt;font style="font-size: 12px;"&gt;staff wait here&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="p8-lk"><mxGeometry x="390" y="46" width="250" height="64" as="geometry" /></mxCell><mxCell id="p8-staff" value="Staff page&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;staff.html; on Accept, joins the caller's room (dashed) and the bot leaves&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1060" y="125" width="220" height="100" as="geometry" /></mxCell><mxCell id="p8-phone" value='Phone caller&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Twilio, Plivo or Exotel; not yet live&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="190" height="80" as="geometry" /></mxCell><mxCell id="p8-runner" value='Pipecat runner&lt;br&gt;&lt;font style="font-size: 12px;"&gt;tells the providers apart by their first message&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="190" height="90" as="geometry" /></mxCell><mxCell id="p8-bot" value="Bot (bot.py): one process for every call" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="310" width="960" height="150" as="geometry" /></mxCell><mxCell id="p8-gate" value="Hold gate&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;drops the caller's words on hold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p8-bot"><mxGeometry x="20" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p8-pipe" value='Speech-to-text, LLM&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Whisper with hotwords, Claude Haiku&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p8-bot"><mxGeometry x="250" y="50" width="200" height="84" as="geometry" /></mxCell><mxCell id="p8-voice" value='Voice switch&lt;br&gt;&lt;font style="font-size: 12px;"&gt;ElevenLabs Flash; Kokoro takes over on failure&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#FFF0E5;strokeColor=#F0B48A;dashed=1;" vertex="1" parent="p8-bot"><mxGeometry x="480" y="50" width="210" height="84" as="geometry" /></mxCell><mxCell id="p8-desk" value='Desk (transfer.py)&lt;br&gt;&lt;font style="font-size: 12px;"&gt;hold music, private briefing, handover&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="p8-bot"><mxGeometry x="720" y="50" width="220" height="84" as="geometry" /></mxCell><mxCell id="p8-tools" value='transfer_to_staff · take_message&lt;br&gt;&lt;font style="font-size: 12px;"&gt;tools.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="520" y="560" width="240" height="70" as="geometry" /></mxCell><mxCell id="p8-msgs" value='Messages&lt;br&gt;&lt;font style="font-size: 12px;"&gt;SQLite&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=15;" vertex="1" parent="1"><mxGeometry x="565" y="700" width="150" height="100" as="geometry" /></mxCell><mxCell id="p8-tel" value='telemetry.py&lt;br&gt;&lt;font style="font-size: 12px;"&gt;spans: call, turns, services, tools, transfer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#EAF7EE;strokeColor=#8CCB9F;" vertex="1" parent="1"><mxGeometry x="860" y="700" width="240" height="80" as="geometry" /></mxCell><mxCell id="p8-jaeger" value='Jaeger or SigNoz&lt;br&gt;&lt;font style="font-size: 12px;"&gt;OTLP/HTTP&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1B1F24;fontSize=15;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1160" y="700" width="170" height="80" as="geometry" /></mxCell><mxCell id="p8-e0" value="audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;" edge="1" parent="1" source="p8-caller" target="p8-croom"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e1" value="Accept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;" edge="1" parent="1" source="p8-staff" target="p8-droom"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;exitX=0.5;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="p8-staff" target="p8-croom"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e3" value="caller audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;startArrow=classic;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p8-croom" target="p8-gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e4" value="briefing, as speech and text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p8-desk" target="p8-droom"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e5" value="8 kHz audio over a WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p8-phone" target="p8-runner"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p8-runner" target="p8-gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p8-gate" target="p8-pipe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p8-pipe" target="p8-voice"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e9" value="tool calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="p8-pipe" target="p8-tools"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e10" value="begin the transfer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p8-tools" target="p8-desk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e11" value="nobody free" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p8-tools" target="p8-msgs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e12" value="spans" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;dashed=1;exitX=0.62;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="p8-bot" target="p8-tel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8-e13" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=default;fontColor=#1B1F24;" edge="1" parent="1" source="p8-tel" target="p8-jaeger"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
